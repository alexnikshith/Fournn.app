{
  "name": "fournn-app",
  "version": "1.0.0",
  "description": "Fournn — AI Personal Operating System",
  "main": "server/src/server.js",
  "scripts": {
    "setup": "cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "node server/src/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Fournn Team",
  "license": "MIT"
}
